{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servtechllmv2worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "servtechllmv2db",
      "database_id": "24b91c9b-290b-4b73-ac11-24a695fb6182"
    }
  ],
  // servtechllmv2r2 exists (created for naming-scheme parity with the rest of
  // ServTech-v2) but isn't bound here — this app has no upload feature, so
  // there's nothing for an R2 binding to do yet. Add an r2_buckets entry if
  // that changes.
  // Attaches testllm.warnetwork.cloud directly to this Worker (DNS + SSL
  // auto-provisioned by Cloudflare). warnetwork.cloud's zone already exists
  // in this account, so unlike servtechworker's warnetwork.online this
  // should attach cleanly on the next deploy with no zone setup needed.
  "routes": [
    { "pattern": "testllm.warnetwork.cloud", "custom_domain": true }
  ],
  "upload_source_maps": true
}
