{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testllm-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testllm-d1",
      "database_id": "050069f0-fa58-4b0c-bffa-627691d7aa27"
    }
  ],
  // testllm-r2 exists (created for naming-scheme parity) but isn't bound
  // here — this app has no upload feature, so there's nothing for an R2
  // binding to do yet. Add an r2_buckets entry if that changes.
  // Attaches testllm.warnetwork.cloud directly to this Worker (DNS + SSL
  // auto-provisioned by Cloudflare). warnetwork.cloud's zone already exists
  // in this account, so this should attach cleanly on the next deploy with
  // no zone setup needed.
  "routes": [
    { "pattern": "testllm.warnetwork.cloud", "custom_domain": true }
  ],
  "upload_source_maps": true
}
